---
import type { ShapeOptions } from '../components/ShapeManager';
import PageLayout from '../layouts/PageLayout.astro';

const date = new Date().getFullYear();

const defaultShapes: ShapeOptions[] = [
  {
    // Rectangle
    type: 'rectangle',
    percentX: 0.25,
    percentY: 0.5,
    width: 414,
    height: 414,
    speed: 0.0025,
    offset: 10,
    stroke: '#d03232',
    strokeWidth: 12,
    rotation: 22
  },
  {
    // Circle
    type: 'circle',
    percentX: 0.75,
    percentY: 0.6,
    radius: 221,
    speed: 0.0025,
    offset: 10,
    strokeDasharray: '16, 16',
    stroke: '#3489c7',
    strokeWidth: 12,
    rotation: 10
  }
];

const description =
  'Get in touch with Dylan Almond for web development, app design, and digital product inquiries. Email, call, or connect via LinkedIn.';
---

<PageLayout
  title='Contact'
  description={description}
  shapes={defaultShapes}
  class='mt-4 flex flex-col items-center gap-12 xl:flex-row xl:items-start xl:justify-between'
>
  <h1
    class='text-inverted z-10 mb-8 text-7xl capitalize mix-blend-difference shadow-lg sm:mb-16 sm:text-8xl xl:my-auto xl:text-[17.5rem]'
  >
    Let's Talk.
  </h1>

  <!-- Contacts -->
  <div
    class='flex flex-col items-center gap-16 text-center md:gap-32 xl:flex-row xl:items-start xl:gap-16 xl:text-start'
  >
    <div class='flex flex-col gap-4'>
      <h2 class='mb-6 text-[3.5rem] leading-0 md:mb-12 md:text-8xl'>Contacts</h2>

      <a class='text-primary/80 font-serif text-xl md:text-4xl' href='mailto:dylan@dylanalmond.net'
        >dylan@dylanalmond.net</a
      >
      <a class='text-primary/80 font-serif text-xl md:text-4xl' href='tel:+4407900414970'
        >+44 07900 414 970</a
      >
    </div>

    <div class='flex flex-col gap-4'>
      <h2 class='mb-6 text-[3.5rem] leading-0 md:mb-12 md:text-8xl'>Social</h2>

      <a
        class='text-primary/80 font-serif text-xl md:text-4xl'
        href='https://www.linkedin.com/in/dylan-almond/'>LinkedIn</a
      >
    </div>

    <!-- Copyright and Privacy Policy -->
    <!-- <span class='text-primary/80 absolute bottom-0 left-0 font-serif text-base xl:text-2xl'
      >@{date} Dylan Almond</span
    > -->
    <!-- <a
      class='text-primary/80 absolute right-0 bottom-0 font-serif text-base xl:text-2xl'
      href='/privacy-policy'>Privacy Policy</a
    > -->

    <span
      class='text-primary/80 absolute bottom-0 left-1/2 -translate-x-1/2 transform font-serif text-sm'
      >@{date} Dylan Almond</span
    >
  </div>
</PageLayout>
