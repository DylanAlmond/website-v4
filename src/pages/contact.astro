---
import type { ShapeOptions } from '../components/ShapeManager';
import { ContactSchema } from '../config/schema';
import { site } from '../config/site';
import PageLayout from '../layouts/PageLayout.astro';
import type { ContactPage } from 'schema-dts';

const date = new Date().getFullYear();

const defaultShapes: ShapeOptions[] = [
  {
    // Rectangle
    type: 'rectangle',
    percentX: 0.25,
    percentY: 0.5,
    width: 414,
    height: 414,
    speed: 0.0025,
    offset: 10,
    stroke: '#d03232',
    strokeWidth: 12,
    rotation: 22
  },
  {
    // Circle
    type: 'circle',
    percentX: 0.75,
    percentY: 0.6,
    radius: 221,
    speed: 0.0025,
    offset: 10,
    strokeDasharray: '16, 16',
    stroke: '#3489c7',
    strokeWidth: 12,
    rotation: 10
  }
];

// Page Meta
const title = 'Contact | Dylan Almond';
const description =
  'Get in touch with Dylan Almond for web development, app design, and digital product inquiries. Email, call, or connect via LinkedIn.';
const canonicalUrl = new URL(Astro.url.pathname, site.url);
const pageSchema = ContactSchema(canonicalUrl.toString(), title, description);
---

<PageLayout
  title={title}
  leftBarLabel='Contact'
  description={description}
  shapes={defaultShapes}
  class='mt-4 flex flex-col items-center gap-8 xl:items-end xl:justify-start xl:gap-12'
>
  <!-- Head meta -->
  <Fragment slot='head'>
    <script type='application/ld+json' set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <h1
    class='text-inverted top-1/2 left-0 z-10 transform text-6xl capitalize mix-blend-difference shadow-lg transition-all duration-1000 ease-in-out sm:text-8xl xl:absolute xl:-translate-y-1/2 xl:text-[17.5rem]'
  >
    Let's Talk.
  </h1>

  <!-- Contacts -->
  <div
    class='flex flex-col items-center gap-8 text-center xl:flex-row xl:items-start xl:gap-16 xl:text-start'
  >
    <div aria-labelledby='contact-methods-heading' class='flex flex-col gap-4'>
      <h2 id='contact-methods-heading' class='text-5xl xl:mb-2 xl:text-8xl'>Contacts</h2>

      <address class='flex flex-col gap-4 not-italic'>
        <a
          class='text-primary/80 font-serif text-xl transition-all duration-250 ease-in-out hover:opacity-60 xl:text-4xl'
          href={`mailto:${site.email}`}>{site.email}</a
        >
        <a
          class='text-primary/80 font-serif text-xl transition-all duration-250 ease-in-out hover:opacity-60 xl:text-4xl'
          href=`tel:${site.telephone}`>{site.telephone}</a
        >
      </address>
    </div>

    <div aria-labelledby='social-links-heading' class='flex flex-col gap-4'>
      <h2 id='social-links-heading' class='text-5xl xl:mb-2 xl:text-8xl'>Social</h2>

      <a
        class='text-primary/80 font-serif text-xl transition-all duration-250 ease-in-out hover:opacity-60 xl:text-4xl'
        target='_blank'
        rel='noopener noreferrer'
        href={site.socials.linkedin}>LinkedIn</a
      >

      <a
        class='text-primary/80 font-serif text-xl transition-all duration-250 ease-in-out hover:opacity-60 xl:text-4xl'
        target='_blank'
        rel='noopener noreferrer'
        href={site.socials.github}>GitHub</a
      >
    </div>

    <div aria-labelledby='other-links-heading' class='flex flex-col gap-4'>
      <h2 id='other-links-heading' class='text-5xl xl:mb-2 xl:text-8xl'>Other</h2>

      <a
        class='text-primary/80 font-serif text-xl transition-all duration-250 ease-in-out hover:opacity-60 xl:text-4xl'
        target='_blank'
        rel='noopener noreferrer'
        href={site.cv}>CV</a
      >
    </div>
  </div>
</PageLayout>
