---
import { Image } from 'astro:assets';
import ChapelImage from '../images/chapel.png';
import PageLayout from '../layouts/PageLayout.astro';
import JsonLD from '../components/JsonLD.astro';
import { site } from '../config/site';
import { AboutSchema } from '../config/schema';

// Page Meta
const title = 'About | Dylan Almond';
const description = `Based in Southampton, I collaborate with businesses across the UK and beyond to create modern
    websites, apps, and digital products that stand out.`;
const canonicalUrl = new URL(Astro.url.pathname, site.url);
const pageSchema = AboutSchema(canonicalUrl.toString(), title, description);
---

<PageLayout title={title} leftBarLabel={'About'} inverted={true} description={description}>
  <!-- Head meta -->
  <Fragment slot='head'>
    <JsonLD graph={pageSchema} />
  </Fragment>

  <h1 class='z-10 text-white capitalize shadow-lg lg:max-w-1/2'>
    {description}
  </h1>

  <Image
    class='fixed top-0 left-0 -z-1 h-full w-full object-cover object-center'
    src={ChapelImage}
    alt={'A chapel.'}
  />
</PageLayout>

<style>
  h1 {
    font-size: clamp(1rem, min(10vw, 7.25vh), 6rem);
    line-height: 1.1;
  }
</style>
