---
import BaseLayout from '../layouts/BaseLayout.astro';

const defaultText = `I deliver modern digital solutions that prepare businesses for what's next. From brand transformation to striking visual content, I turn strategy into measurable impact.`;

const services = {
  'Web Development': 'Web Development Description',
  'App Development': 'App Development Description',
  'Software Development': 'Software Development Description',
  'AI Development': 'AI Development Description',
  'Backend Systems': 'Backend Systems Description',
  'Design & SEO': 'Design & SEO Description'
};
---

<BaseLayout title='Services' class='flex flex-col'>
  <h1
    class='text-inverted mb-8 text-[3.5rem] capitalize mix-blend-difference shadow-lg md:text-8xl'
  >
    What I Deliver
  </h1>
  <div class='grid gap-8 lg:grid-cols-2 lg:gap-32'>
    <div class='flex flex-col gap-8'>
      <p
        id='service-description'
        data-default-description={defaultText}
        class='text-primary/80 font-serif text-2xl md:text-4xl'
      >
      </p>
    </div>

    <div>
      <ol>
        {
          Object.keys(services).map((v) => (
            <li
              class='hover:bg-primary data-[active=true]:bg-primary cursor-pointer gap-3! py-5! pl-3! text-[1.75rem]! before:text-xl! hover:text-white hover:before:text-white/80! data-[active=true]:text-white data-[active=true]:before:text-white/80! md:gap-6! md:py-6! md:pl-6! md:text-4xl! md:before:text-[1.75rem]! xl:text-5xl!'
              data-service-item={v}
              data-service-description={services[v as keyof typeof services]}
              tabindex='0'
              role='button'
              aria-label={v}
            >
              {v}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</BaseLayout>

<script>
  const descriptionElem = document.querySelector<HTMLParagraphElement>('#service-description')!;
  const serviceItems = document.querySelectorAll<HTMLLIElement>('[data-service-item]');

  const defaultDescription = descriptionElem.getAttribute('data-default-description');
  descriptionElem.textContent = defaultDescription;

  // Helper to set active item
  function setActiveItem(item: HTMLLIElement | null) {
    serviceItems.forEach((i) => i.setAttribute('data-active', 'false'));
    if (item) {
      item.setAttribute('data-active', 'true');
      descriptionElem.textContent = item.getAttribute('data-service-description');
      item.focus();
    } else {
      descriptionElem.textContent = defaultDescription;
    }
  }

  serviceItems.forEach((item, idx) => {
    item.addEventListener('click', () => {
      setActiveItem(item);
    });

    item.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        setActiveItem(item);
      }
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const next = serviceItems[(idx + 1) % serviceItems.length];
        next.focus();
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prev = serviceItems[(idx - 1 + serviceItems.length) % serviceItems.length];
        prev.focus();
      }
      if (e.key === 'Escape') {
        setActiveItem(null);
      }
    });
  });

  // Deselect on click away
  document.addEventListener('click', (e) => {
    // If click is outside any service item
    if (![...serviceItems].some((item) => item.contains(e.target as HTMLElement))) {
      setActiveItem(null);
    }
  });
</script>

<style>
  @reference '../styles/global.css';

  ol {
    @apply divide-primary border-primary divide-y-2 border-y-2;
    list-style: none;
    counter-reset: list-counter;
  }

  li {
    @apply flex items-center gap-6 py-6 pl-6 font-serif text-5xl;
    counter-increment: list-counter;

    &::before {
      @apply text-primary/80 text-[1.75rem];
      content: counter(list-counter, decimal-leading-zero) ' ';
    }
  }
</style>
