---
import BaseLayout from '../layouts/BaseLayout.astro';

const defaultText = `I deliver modern digital solutions that prepare businesses for what's next. From brand transformation to striking visual content, I turn strategy into measurable impact.`;

const services = {
  'Web Development': 'Web Development Description',
  'App Development': 'App Development Description',
  'Software Development': 'Software Development Description',
  'AI Development': 'AI Development Description',
  'Backend Systems': 'Backend Systems Description',
  'Design & SEO': 'Design & SEO Description'
};
---

<BaseLayout title='Services' class='flex flex-col'>
  <h1
    class='text-inverted mb-8 text-[3.5rem] capitalize mix-blend-difference shadow-lg md:text-8xl'
  >
    What I Deliver
  </h1>
  <div
    x-data=`{
      activeItem: null,
      defaultDescription: "${defaultText}",
      currentDescription: "${defaultText}",
      services: ${JSON.stringify(Object.entries(services).map(([name, description]) => ({ name, description })))},
      focusedIndex: -1,

      selectService(service) {
        this.activeItem = service.name;
        this.currentDescription = service.description;
      },
      
      deselectService() {
        this.activeItem = null;
        this.currentDescription = this.defaultDescription;
      },

      handleKeydown(event, service) {
        const currentIndex = this.services.findIndex(s => s.name === service.name);
        
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          this.selectService(service);
        } else if (event.key === 'Escape') {
          this.deselectService();
          event.target.blur();
          this.focusedIndex = -1;
        }
      }
    }`
    class='grid gap-8 lg:grid-cols-2 lg:gap-32'
  >
    <div class='flex flex-col gap-8'>
      <p
        id='service-description'
        x-text='currentDescription'
        class='text-primary/80 font-serif text-2xl md:text-4xl'
      >
      </p>
    </div>

    <div>
      <ol>
        <template x-for='(service, index) in services' :key='service.name'>
          <li
            class='hover:bg-primary focus:ring-primary cursor-pointer gap-3! py-5! pl-3! text-[1.75rem]! transition-all duration-200 before:text-xl! hover:text-white hover:before:text-white/80! focus:ring-2 focus:ring-offset-2 focus:outline-none md:gap-6! md:py-6! md:pl-6! md:text-4xl! md:before:text-[1.75rem]! xl:text-5xl!'
            :class="activeItem === service.name && 'bg-primary text-white before:text-white/80!'"
            @click='selectService(service)'
            @keydown='handleKeydown($event, service)'
            tabindex='0'
            role='button'
            :aria-label='"Select " + service.name + " service"'
            :aria-pressed='activeItem === service.name'
            :aria-describedby='activeItem === service.name ? "service-description" : null'
            x-text='service.name'
          >
          </li>
        </template>
      </ol>
    </div>
  </div>
</BaseLayout>

<style>
  @reference '../styles/global.css';

  ol {
    @apply divide-primary border-primary divide-y-2 border-y-2;
    list-style: none;
    counter-reset: list-counter;
  }

  li {
    @apply flex items-center gap-6 py-6 pl-6 font-serif text-5xl;
    counter-increment: list-counter;

    &::before {
      @apply text-primary/80 text-[1.75rem];
      content: counter(list-counter, decimal-leading-zero) ' ';
    }
  }
</style>
