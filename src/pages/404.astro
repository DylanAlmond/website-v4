---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/Button.astro';

const description =
  "404 Page Not Found - The page you're looking for doesn't exist. Return home to explore Dylan Almond's websites, apps, and digital projects.";
---

<PageLayout
  title='Dylan Almond'
  description={description}
  leftBarLabel='Not Found'
  class='flex flex-col items-center justify-center gap-6'
>
  <h1 class='mb-2 w-full transform text-center leading-none capitalize'>Oops!</h1>

  <h2 class='text-primary/80 font-sans! text-3xl font-semibold'>Page Not Found.</h2>

  <p class='text-primary/80 max-w-4xl text-center text-xl'>
    It looks like the page you are looking for does not exist or has been removed. Go back or
    headover to <a href='/' class='font-semibold'>dylanalmond.net</a> to choose a new direction.
  </p>

  <Button href='/'>Go Home</Button>
</PageLayout>

<style>
  h1 {
    font-size: clamp(1rem, min(20vw, 20vh), 8rem);
    line-height: 1.2;
  }
</style>
