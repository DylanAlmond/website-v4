---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import type { ShapeOptions } from '../../components/ShapeManager';
import JsonLD from '../../components/JsonLD.astro';
import { site } from '../../config/site';
import { BlogSchema } from '../../config/schema';
import Pin from '../../images/pin.svg';

const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))
).sort((a, b) => {
  // If one is pinned and the other is not → pinned goes first
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;

  // Otherwise sort by dateStarted descending
  return b.data.dateStarted.valueOf() - a.data.dateStarted.valueOf();
});

const defaultShapes: ShapeOptions[] = [
  {
    // Triangle
    type: 'polygon',
    percentX: 0.2,
    percentY: 0.7,
    radius: 200,
    sides: 3,
    speed: 0.005,
    offset: 10,
    stroke: '#d03232',
    strokeWidth: 8,
    rotation: -105
  },
  {
    // Pentagon
    type: 'polygon',
    percentX: 0.68,
    percentY: 0.5,
    radius: 450,
    sides: 5,
    speed: 0.001,
    offset: 30,
    strokeDasharray: '32, 32',
    stroke: '#c7347b',
    strokeWidth: 16,
    rotation: -10
  }
];

// Page Meta
const title = 'Work | Dylan Almond';
const description = "Explore Dylan Almond's portfolio of websites, apps, and digital projects.";
const canonicalUrl = new URL(Astro.url.pathname, site.url);
const pageSchema = BlogSchema(canonicalUrl.toString(), posts, title, description);
---

<PageLayout
  title={title}
  leftBarLabel='Work'
  description={description}
  class='flex flex-col'
  shapes={defaultShapes}
>
  <!-- Head meta -->
  <Fragment slot='head'>
    <JsonLD graph={pageSchema} />
  </Fragment>

  <div
    x-data=`{
      posts: ${JSON.stringify(posts)},
      activeItem: ${JSON.stringify(posts[0])},

      highlightWork(data) {      
        this.activeItem = data;
      },
      
      reset() {
        this.activeItem = null;
      }
    }`
    class='grid h-full gap-16 xl:grid-cols-2'
  >
    <div class='relative hidden overflow-hidden xl:flex'>
      <!-- Workaround due to not being able to serve /src/images content dynamically from a single `<Image />` component. -->
      {
        posts.map((post) => (
          <a
            x-show={`activeItem?.id === '${post.id}'`}
            x-transition:enter='transition-all duration-500 ease-in'
            x-transition:enter-start='opacity-0'
            x-transition:enter-end='opacity-100'
            x-transition:leave='transition-all duration-500 ease-in'
            x-transition:leave-start='opacity-100'
            x-transition:leave-end='opacity-0'
            aria-label={`"Go to ${post.data.title} project"`}
            class='absolute inset-0'
            href={`/work/${post.id}`}
          >
            <Image
              loading={'eager'}
              src={post.data.image.src}
              alt={post.data.image.alt}
              class='h-full w-full object-cover'
            />
          </a>
        ))
      }
    </div>

    <div class='flex flex-col overflow-hidden'>
      <h1
        class='text-inverted z-10 mb-8 text-[3.5rem] capitalize mix-blend-difference shadow-lg md:text-8xl'
      >
        Work
      </h1>

      <ul
        class='divide-primary border-primary no-scrollbar h-fit divide-y-2 overflow-x-visible overflow-y-auto border-y-2'
      >
        <template x-for='(post, index) in posts' :key='post.id'>
          <li>
            <a
              class='hover:bg-primary group flex w-full cursor-pointer items-center gap-3 px-3 py-4 font-serif text-[1.75rem] transition-all duration-200 hover:text-white focus:outline-none md:gap-6 md:px-6 md:py-6 md:text-4xl xl:text-5xl'
              :class="activeItem?.id === post.id && 'bg-primary text-white'"
              :aria-label='"Go to " + post.data.title + " project"'
              @mouseover='highlightWork(post)'
              @focus='highlightWork(post)'
              :href='"/work/" + post.id'
            >
              <span x-text='post.data.title'></span>
              <template x-if='post.data.draft'>
                <span class='text-red ml-auto'>Draft</span>
              </template>

              <template x-if='post.data.pinned'>
                <span class='ml-auto'>
                  <span class='sr-only'>Pinned</span>
                  <Pin
                    aria-hidden='true'
                    class={'size-7 md:size-10 fill-red stroke-red group-hover:fill-white group-hover:stroke-white stroke-[1] -rotate-12 transition-all duration-200'}
                    :class="activeItem?.id === post.id && 'fill-white stroke-white'"
                  />
                </span>
              </template>
            </a>
          </li>
        </template>
      </ul>
    </div>
  </div>
</PageLayout>

<style>
  @reference '../../styles/global.css';

  body {
    @apply h-dvh overflow-hidden;
  }
</style>
