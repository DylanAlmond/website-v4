---
import BaseLayout from '../layouts/BaseLayout.astro';

const date = new Date().getFullYear();
---

<BaseLayout title='Dylan Almond'>
  <h1
    class='capitalize text-9xl text-center absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2'
  >
    creatively Driven Web Development
  </h1>

  <span
    class='font-serif text-sm text-primary/80 absolute bottom-0 left-1/2 transform -translate-x-1/2'
    >@{date} Dylan Almond</span
  >
</BaseLayout>
