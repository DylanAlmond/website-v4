---
import type { ShapeOptions } from '../components/ShapeManager';
import Shapes from '../components/Shapes.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const date = new Date().getFullYear();

const defaultShapes: ShapeOptions[] = [
  {
    // Triangle
    type: 'polygon',
    percentX: 0.32,
    percentY: 0.6,
    radius: 200,
    sides: 3,
    speed: 0.0025,
    offset: 10,
    stroke: '#d03232',
    strokeWidth: 8,
    rotation: 45
  },
  {
    // Square
    type: 'rectangle',
    percentX: 0.16,
    percentY: 0.27,
    width: 240,
    height: 240,
    speed: 0,
    offset: 10,
    stroke: '#34c738',
    strokeWidth: 8,
    rotation: 15
  },
  {
    // Pentagon
    type: 'polygon',
    percentX: 0.82,
    percentY: 0.75,
    radius: 170,
    sides: 5,
    speed: 0.0025,
    offset: 10,
    stroke: '#ffc300',
    strokeWidth: 8,
    rotation: 10
  },
  {
    // Circle
    type: 'circle',
    percentX: 0.67,
    percentY: 0.4,
    radius: 150,
    speed: 0.0025,
    offset: 10,
    stroke: '#3489C7',
    strokeDasharray: '16, 16',
    strokeWidth: 8,
    rotation: 10,
    borderRadius: 110
  },
  {
    // Semi-circle
    type: 'rectangle',
    percentX: 0.18,
    percentY: 0.81,
    width: 300,
    height: 150,
    speed: 0,
    offset: 10,
    stroke: '#C7347B',
    strokeDasharray: '16, 16',
    strokeWidth: 8,
    rotation: 75,
    borderRadius: [150, 150, 0, 0]
  }
];
---

<BaseLayout title='Dylan Almond' leftBarLabel='Home'>
  <h1
    class='text-inverted fixed top-1/2 left-1/2 z-10 w-full -translate-x-1/2 -translate-y-1/2 transform text-center leading-none capitalize mix-blend-difference select-none'
    x-data="{
      services: [
        'Web Development',
        'App Design',
        'UI/UX', 
        'SEO Optimization',
        'E-Commerce Solutions'
      ],
      currentIndex: 0,
      isVisible: true,
      fadeDuration: 1000,
      displayDuration: 2000,
      intervalId: null,
      
      init() {
        console.log('Start Cycling');
        this.startCycling();
        
        // Clean up when component is destroyed
        this.$watch('$el', (el) => {
          if (!el) this.cleanup();
        });
        
        // Listen for Astro navigation events
        document.addEventListener('astro:before-preparation', () => {
          this.cleanup();
        });
      },
      
      cleanup() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
          this.intervalId = null;
          console.log('Cleaned up interval');
        }
      },
    
      showNextService() {
        console.log('Cycling');
        
        // Fade out
        this.isVisible = false;
        
        setTimeout(() => {
          // Change text after fade out and prepare next index
          this.currentIndex = (this.currentIndex + 1) % this.services.length;
          // Fade in
          this.isVisible = true;
        }, this.fadeDuration);
      },
      
      startCycling() {
        this.intervalId = setInterval(() => {
          this.showNextService();
        }, this.fadeDuration + this.displayDuration);
      },
      
      get currentService() {
        return this.services[this.currentIndex];
      },
      
      get currentYear() {
        return new Date().getFullYear();
      }
    }"
  >
    creatively Driven<br />
    <span
      x-text='currentService'
      x-show='isVisible'
      x-transition:enter='transition-opacity duration-1000'
      x-transition:enter-start='opacity-0'
      x-transition:enter-end='opacity-100'
      x-transition:leave='transition-opacity duration-1000'
      x-transition:leave-start='opacity-100'
      x-transition:leave-end='opacity-0'></span>
  </h1>

  <span
    class='text-primary/80 absolute bottom-0 left-1/2 -translate-x-1/2 transform font-serif text-sm'
    >@{date} Dylan Almond</span
  >
</BaseLayout>

<Shapes shapes={defaultShapes} />

<style>
  h1 {
    font-size: clamp(1rem, min(10vw, 10vh), 8rem);
    line-height: 1.2;
  }
</style>
