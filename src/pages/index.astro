---
import Button from '../components/Button.astro';
import JsonLD from '../components/JsonLD.astro';
import type { ShapeOptions } from '../components/ShapeManager';
import { WebSiteSchema } from '../config/schema';
import { site } from '../config/site';
import PageLayout from '../layouts/PageLayout.astro';

const date = new Date().getFullYear();

const defaultShapes: ShapeOptions[] = [
  {
    // Triangle
    type: 'polygon',
    percentX: 0.32,
    percentY: 0.6,
    radius: 200,
    sides: 3,
    speed: 0.005,
    offset: 10,
    stroke: '#d03232',
    strokeWidth: 8,
    rotation: 45
  },
  {
    // Square
    type: 'rectangle',
    percentX: 0.16,
    percentY: 0.27,
    width: 240,
    height: 240,
    speed: 0.005,
    offset: 10,
    stroke: '#34c738',
    strokeWidth: 8,
    rotation: 15
  },
  {
    // Pentagon
    type: 'polygon',
    percentX: 0.82,
    percentY: 0.75,
    radius: 170,
    sides: 5,
    speed: 0.005,
    offset: 10,
    stroke: '#ffc300',
    strokeWidth: 8,
    rotation: 10
  },
  {
    // Circle
    type: 'circle',
    percentX: 0.67,
    percentY: 0.4,
    radius: 150,
    speed: 0.005,
    offset: 10,
    stroke: '#3489C7',
    strokeDasharray: '16, 16',
    strokeWidth: 8,
    rotation: 10,
    borderRadius: 110
  },
  {
    // Semi-circle
    type: 'rectangle',
    percentX: 0.18,
    percentY: 0.81,
    width: 300,
    height: 150,
    speed: 0.005,
    offset: 10,
    stroke: '#C7347B',
    strokeDasharray: '16, 16',
    strokeWidth: 8,
    rotation: 75,
    borderRadius: [2000, 2000, 0, 0]
  }
];

// Page Meta
const title = 'Dylan Almond';
const description =
  'Creative web developer delivering modern websites, apps, and digital products. Specializing in web development, app design, UI/UX, SEO optimization, and e-commerce solutions.';
const canonicalUrl = new URL(Astro.url.pathname, site.url);
const pageSchema = WebSiteSchema(canonicalUrl.toString(), title, description);
---

<PageLayout
  title={title}
  description={description}
  leftBarLabel='Home'
  shapes={defaultShapes}
  class={'flex flex-col mt-12! justify-center gap-8 lg:gap-16 items-center'}
>
  <!-- Head meta -->
  <Fragment slot='head'>
    <JsonLD graph={pageSchema} />
  </Fragment>

  <h1
    class='text-inverted w-full text-center leading-none capitalize mix-blend-difference select-none'
    x-data=`{
      services: ${JSON.stringify(site.services.map((s) => s.name))},
      currentIndex: 0,
      isVisible: true,
      fadeDuration: 1000,
      displayDuration: 2000,
      intervalId: null,
      
      init() {
        // console.log('Start Cycling');
        this.startCycling();
        
        // Clean up when component is destroyed
        this.$watch('$el', (el) => {
          if (!el) this.cleanup();
        });
        
        // Listen for Astro navigation events
        document.addEventListener('astro:before-preparation', () => {
          this.cleanup();
        });
      },
      
      cleanup() {
        if (this.intervalId) {
          clearInterval(this.intervalId);
          this.intervalId = null;
          // console.log('Cleaned up interval');
        }
      },
    
      showNextService() {
        // console.log('Cycling');
        
        // Fade out
        this.isVisible = false;
        
        setTimeout(() => {
          // Change text after fade out and prepare next index
          this.currentIndex = (this.currentIndex + 1) % this.services.length;
          // Fade in
          this.isVisible = true;
        }, this.fadeDuration);
      },
      
      startCycling() {
        this.intervalId = setInterval(() => {
          this.showNextService();
        }, this.fadeDuration + this.displayDuration);
      },
      
      get currentService() {
        return this.services[this.currentIndex];
      },
      
      get currentYear() {
        return new Date().getFullYear();
      }
    }`
  >
    creatively Driven<br />
    <span
      x-text='currentService'
      x-show='isVisible'
      x-transition:enter='transition-opacity duration-1000'
      x-transition:enter-start='opacity-0'
      x-transition:enter-end='opacity-100'
      x-transition:leave='transition-opacity duration-1000'
      x-transition:leave-start='opacity-100'
      x-transition:leave-end='opacity-0'></span>
  </h1>

  <div class='flex flex-wrap justify-center gap-4 transition-all duration-500 ease-in-out lg:gap-8'>
    <Button href='/work'>View My Work</Button>
    <Button href='/contact' variant='outline'>Contact</Button>
  </div>

  <Fragment slot='footer'>
    <footer
      class='fixed bottom-8 left-1/2 -translate-x-1/2 transform transition-all duration-700 ease-in-out lg:bottom-12'
    >
      <small class='text-primary/80 font-serif text-sm'>@{date} Dylan Almond</small>
    </footer>
  </Fragment>
</PageLayout>

<style>
  h1 {
    font-size: clamp(1rem, min(10vw, 10vh), 8rem);
    line-height: 1.2;
  }
</style>
