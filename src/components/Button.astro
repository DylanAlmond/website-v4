---
type ButtonProps = astroHTML.JSX.ButtonHTMLAttributes & astroHTML.JSX.AnchorHTMLAttributes;

interface Props extends ButtonProps {
  href?: string;
  class?: string;
}

const { href, class: className, ...props } = Astro.props;
const baseClasses =
  'inline-flex items-center justify-center bg-brown px-[2.375rem] cursor-pointer h-16 min-w-40 font-serif text-4xl leading-0 text-white italic shadow-lg transition-all duration-250 ease-in-out hover:opacity-75';
---

{
  href ? (
    <a href={href} class={`${baseClasses} ${className ?? ''}`} {...props}>
      <slot />
    </a>
  ) : (
    <button class={`${baseClasses} ${className ?? ''}`} {...props}>
      <slot />
    </button>
  )
}
