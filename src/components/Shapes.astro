---
import clsx from 'clsx';
import type { ShapeOptions } from './ShapeManager';

interface Props {
  shapes: ShapeOptions[];
  class?: string;
}

const { shapes, class: className } = Astro.props;

// Generate a unique ID for every canvas element
const canvasId = `canvas-${Math.random().toString(36).substring(2, 11)}`;
---

<div class={clsx('absolute top-0 left-0 h-full w-full pointer-events-none', className)}>
  <canvas id={canvasId} class='h-full w-full'> </canvas>
</div>

<script define:vars={{ canvasId, shapes }}>
  import('./src/components/ShapeManager.ts').then(({ ShapeManager }) => {
    const canvas = document.getElementById(canvasId);
    if (canvas && shapes) {
      new ShapeManager(canvas, shapes);
    }
  });
</script>
