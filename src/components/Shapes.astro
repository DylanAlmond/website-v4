---
import type { ShapeOptions } from './ShapeManager';

interface Props {
  shapes: ShapeOptions[];
  class?: string;
}

const { shapes, class: className } = Astro.props;
---

<shape-canvas class={className} shapes={JSON.stringify(shapes)}></shape-canvas>

<script>
  import { ShapeManager, type ShapeOptions } from './ShapeManager';

  class ShapeCanvas extends HTMLElement {
    private canvas!: HTMLCanvasElement;
    private shapes: ShapeOptions[] = [];
    private manager: ShapeManager | null = null;

    static get observedAttributes() {
      return ['shapes'];
    }

    connectedCallback() {
      // Create shadow DOM if you want encapsulation
      const shadow = this.attachShadow({ mode: 'open' });

      this.canvas = document.createElement('canvas');
      this.canvas.style.width = '100%';
      this.canvas.style.height = '100%';
      this.canvas.style.pointerEvents = 'none';
      this.canvas.style.overflow = 'hidden';

      shadow.appendChild(this.canvas);

      this.initManager();
    }

    disconnectedCallback() {
      this.manager?.stop();
      this.manager = null;
    }

    attributeChangedCallback(name: string, _old: string, value: string) {
      if (name === 'shapes' && value) {
        try {
          this.shapes = JSON.parse(value);
          this.manager?.stop();
          this.manager = null;
          this.initManager();
        } catch {
          console.warn('Invalid shapes JSON passed to <shape-canvas>');
        }
      }
    }

    private initManager() {
      if (this.canvas && this.shapes.length > 0) {
        this.manager = new ShapeManager(this.canvas, this.shapes);
      }
    }
  }

  customElements.define('shape-canvas', ShapeCanvas);
</script>
