---
import PageBar from './PageBar.astro';

const routes = {
  Home: '/',
  Work: '/work',
  About: '/about',
  Services: '/services',
  Contact: '/contact'
};
---

<div
  x-data=`{ 
    open: false, 
    routes: ${JSON.stringify(Object.entries(routes).map(([name, href]) => ({ name, href })))}
  }`
>
  <!-- Toggle Button -->
  <button class='cursor-pointer' @click='$store.menuOpen = ! $store.menuOpen'>
    <img
      :src="inverted && !$store.menuOpen ? '/menu-inverted.svg' : '/menu.svg'"
      src={'/menu.svg'}
      height='48px'
      width='48px'
      alt='Open Menu Icon'
    />
  </button>

  <!-- Fullscreen Menu -->
  <template x-teleport='body'>
    <div
      x-show='$store.menuOpen'
      id='nav-menu'
      class='grain bg-background fixed top-0 left-0 z-10 flex h-full min-h-dvh w-full flex-row justify-center gap-12 overflow-y-scroll py-8 transition-all duration-700 ease-in-out md:py-12'
    >
      <!-- Header Shows Here -->

      <PageBar class='fixed top-0 left-12 py-12' label={'Menu'} />

      <div
        class='max-w-container relative mx-8 mt-24 flex w-full flex-1 flex-col gap-12 transition-all duration-1000 ease-in-out md:mx-32'
      >
        <ol class='md:ml-auto md:w-1/2'>
          <template x-for='(route, index) in routes' :key='route.name'>
            <li>
              <a
                class='hover:bg-primary cursor-pointer gap-8! py-5! pl-3! text-5xl! before:text-[1.75rem]! hover:text-white hover:before:text-white/80! md:py-8! md:pl-8! md:text-[5.25rem]!'
                :href='route.href'
                x-text='route.name'
              >
              </a>
            </li>
          </template>
        </ol>
      </div>

      <PageBar class='fixed top-0 right-12 py-12' />
    </div>
  </template>
</div>

<style>
  @reference '../styles/global.css';

  ol {
    list-style: none;
    counter-reset: list-counter;
  }

  a {
    @apply flex items-center gap-6 py-6 pl-6 font-serif text-5xl;
    counter-increment: list-counter;

    &::before {
      @apply text-primary/80 text-[1.75rem];
      content: counter(list-counter, decimal-leading-zero) ' ';
    }
  }
</style>
