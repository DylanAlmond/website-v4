---
import clsx from 'clsx';

interface Props {
  label?: string;
  class?: string | null;
}

const { label, class: className } = Astro.props;
---

<div
  class={clsx(
    `flex flex-col w-8 h-full gap-4 items-center select-none
    transform transition-all duration-1000 ease-in-out
    opacity-0
    md:opacity-100`,
    className
  )}
>
  <hr class={`flex-1 border-l-2 border-primary`} />
  {
    label && (
      <>
        <span
          class={`text-primary max-h-1/2 truncate overflow-visible font-serif text-2xl leading-none italic [text-orientation:mixed] [writing-mode:sideways-lr]`}
        >
          {label}
        </span>
        <hr class={`border-primary flex-1 border-l-2`} />
      </>
    )
  }
</div>

<style>
  @reference '../styles/global.css';

  :root[data-inverted='true'] {
    /* Only invert when nav is closed */
    &:root[data-nav-open='false'] {
      hr {
        @apply border-inverted;
      }

      span {
        @apply text-inverted;
      }
    }
  }
</style>
