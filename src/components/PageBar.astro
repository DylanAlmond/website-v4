---
import clsx from 'clsx';

interface Props {
  label?: string;
  inverted?: boolean;
  class?: string | null;
}

const { label, inverted, class: className } = Astro.props;
---

<div
  class={clsx(
    `flex flex-col w-8 h-full gap-4 items-center select-none
    transform transition-all duration-1000 ease-in-out
    opacity-0
    md:opacity-100`,
    className
  )}
>
  <hr class={`flex-1 border-l-2 ${inverted ? 'border-inverted' : 'border-primary'}`} />
  {
    label && (
      <>
        <span
          class={`${inverted ? 'text-inverted' : 'text-primary'} [writing-mode:sideways-lr] [text-orientation:mixed] truncate max-h-1/2 font-serif leading-none italic text-2xl`}
        >
          {label}
        </span>
        <hr class={`flex-1 border-l-2 ${inverted ? 'border-inverted' : 'border-primary'}`} />
      </>
    )
  }
</div>
