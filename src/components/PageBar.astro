---
import clsx from 'clsx';

interface Props {
  label?: string;
  class?: string | null;
}

const { label, class: className } = Astro.props;
---

<div
  class={clsx(
    `flex flex-col w-8 h-full gap-4 items-center select-none
    transform transition-all duration-1000 ease-in-out
    opacity-0
    md:opacity-100`,
    className
  )}
>
  <hr class='flex-1 border-l-2 border-primary' />
  {
    label && (
      <>
        <span class='[writing-mode:sideways-lr] [text-orientation:mixed] truncate max-h-1/2 font-serif leading-none italic text-2xl'>
          {label}
        </span>
        <hr class='flex-1 border-l-2 border-primary' />
      </>
    )
  }
</div>
