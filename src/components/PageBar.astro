---
import clsx from 'clsx';

interface Props {
  label?: string;
  class?: string | null;
}

const { label, class: className } = Astro.props;
---

<div
  class={clsx(
    `flex flex-col w-8 h-full z-10 gap-4 items-center select-none
    transform transition-all duration-1000 ease-in-out
    opacity-0
    md:opacity-100`,
    className
  )}
>
  <hr class={`flex-1 border-l-2 `} :class="inverted && !$store.menuOpen ? 'border-inverted' : 'border-primary'" />
  {
    label && (
      <>
        <span
          class={`max-h-1/2 truncate overflow-visible font-serif text-2xl leading-none italic [text-orientation:mixed] [writing-mode:sideways-lr]`}
          :class="inverted && !$store.menuOpen ? 'text-inverted' : 'text-primary'"
        >
          {label}
        </span>
        <hr class={`flex-1 border-l-2`} :class="inverted && !$store.menuOpen ? 'border-inverted' : 'border-primary'"/>
      </>
    )
  }
</div>
