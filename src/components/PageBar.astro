---
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<div
  class='flex flex-col h-full gap-4 items-center select-none
    transform transition-all duration-500 ease-in-out
    opacity-0
    md:opacity-100'
>
  <hr class='flex-1 border-l-2 border-primary' />
  {
    label && (
      <>
        <span class='[writing-mode:sideways-lr] [text-orientation:mixed] truncate max-h-1/2 font-serif leading-none italic text-2xl'>
          {label}
        </span>
        <hr class='flex-1 border-l-2 border-primary' />
      </>
    )
  }
</div>
