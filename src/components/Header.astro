---
import Nav from './Nav.astro';
---

<header class='fixed z-20 h-12 w-full px-8 transition-[padding] duration-1250 ease-in-out md:px-32 tras'>
  <div class='max-w-container relative mx-auto flex items-center justify-between'>
    <a
      href='/'
      aria-label='Home'
      class='focus:ring-primary focus:ring-2 focus:ring-offset-2 focus:outline-none transition-all duration-250'
    >
      <img
        id='logo-img'
        :src="inverted && !$store.menuOpen ? '/logo-inverted.svg' : '/logo.svg'"
        src={'/logo.svg'}
        height='48px'
        width='99px'
        alt='Dylan Almond Logo'
      /></a
    >

    <Nav />
  </div>
</header>
