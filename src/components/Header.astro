---
interface Props {
  inverted: boolean;
}

const { inverted } = Astro.props;
---

<header class='flex h-12 w-full items-center justify-between max-w-container'>
  <img
    src={`/logo${inverted ? '-inverted' : ''}.svg`}
    class={inverted ? `mix-blend-difference` : ''}
    height='48px'
    width='99px'
    alt='Dylan Almond Logo'
  />

  <button
    ><img
      src={`/menu${inverted ? '-inverted' : ''}.svg`}
      height='48px'
      width='48px'
      alt='Open Menu Icon'
    /></button
  >
</header>
