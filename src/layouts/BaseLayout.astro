---
import '../styles/global.css';
import clsx from 'clsx';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  inverted?: boolean;
  class?: string | null;
}

const { title, description, inverted = false, class: className } = Astro.props;
---

<html
  lang='en'
  transition:name='root'
  x-data=`inverted(${inverted})`
  :class="$store.menuOpen && 'overflow-hidden'"
>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/png' href='/favicon.png' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
    <meta name='title' content={title} />
    <meta name='description' content={description} />
    <script src='../scripts/local.ts'></script>
    <ClientRouter />
  </head>
  <body
    class={clsx(
      'grain relative flex h-full min-h-dvh w-full flex-row justify-center gap-12 py-8 transition-[padding] duration-1250 ease-in-out md:py-12',
      className
    )}
  >
    <slot />
  </body>
</html>
