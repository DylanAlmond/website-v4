---
import Header from '../components/Header.astro';
import PageBar from '../components/PageBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  negativeHeader?: boolean;
}

const { title, negativeHeader = false } = Astro.props;
---

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class='grain flex gap-12 h-dvh min-h-dvh w-full flex-row justify-between'>
    <PageBar label='Home' />

    <div class='max-w-container flex flex-col gap-12 flex-1'>
      <Header negativeColor={negativeHeader} />

      <main class='flex-1 relative'>
        <slot />
      </main>
    </div>

    <PageBar />
  </body>
</html>
