---
import Header from '../components/Header.astro';
import PageBar from '../components/PageBar.astro';
import '../styles/global.css';
import clsx from 'clsx';

interface Props {
  title: string;
  leftBarLabel?: string;
  rightBarLabel?: string;
  inverted?: boolean;
  class?: string | null;
}

const { title, leftBarLabel, rightBarLabel, inverted = false, class: className } = Astro.props;
---

<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    class='grain flex h-full min-h-dvh w-full flex-row justify-center gap-12 py-8 transition-[padding] duration-1250 ease-in-out md:py-12'
  >
    <PageBar class='fixed top-0 left-12 py-12' label={leftBarLabel ?? title} inverted={inverted} />

    <div
      class='max-w-container mx-8 flex w-full flex-1 flex-col gap-12 transition-all duration-1000 ease-in-out md:mx-32'
    >
      <Header inverted={inverted} />

      <main class={clsx('flex-1 relative', className)}>
        <slot />
      </main>
    </div>

    <PageBar class='fixed top-0 right-12 py-12' label={rightBarLabel} inverted={inverted} />
  </body>
</html>
