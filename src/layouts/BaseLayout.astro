---
import '../styles/global.css';
import clsx from 'clsx';
import { ClientRouter } from 'astro:transitions';
import { site } from '../config/site';
import { pwaInfo } from 'virtual:pwa-info';
import { pwaAssetsHead } from 'virtual:pwa-assets/head';

interface Props {
  title: string;
  description: string;
  inverted?: boolean;
  class?: string | null;
}

const { title, description, inverted = false, class: className } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, site.url);
---

<html
  lang='en'
  transition:name='root'
  x-data=`inverted(${inverted})`
  :class="$store.menuOpen && 'overflow-hidden'"
>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>

    <meta name='title' content={title} />
    <meta name='description' content={description} />

    <!-- Open Graph -->
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:url' content={canonicalUrl} />
    <meta property='og:site_name' content={site.name} />
    <meta property='og:locale' content='en_GB' />

    <!-- Sitemap -->
    <link rel='sitemap' href='/sitemap-index.xml' />

    <!-- RSS -->
    <link
      rel='alternate'
      type='application/rss+xml'
      title='Dylan Almond'
      href={new URL('rss.xml', Astro.site)}
    />

    <!-- Canonical -->
    <link rel='canonical' href={canonicalUrl} />

    <!-- PWA -->
    {
      pwaAssetsHead.themeColor && (
        <meta name='theme-color' content={pwaAssetsHead.themeColor.content} />
      )
    }
    {pwaAssetsHead.links.map((link) => <link {...link} />)}
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script src='/src/pwa.ts'></script>

    <script src='../scripts/local.ts'></script>
    <ClientRouter />

    <slot name='head' />
  </head>
  <body
    class={clsx(
      'grain relative flex h-full min-h-dvh w-full flex-row justify-center gap-12 py-8 transition-[padding] duration-1250 ease-in-out md:py-12',
      className
    )}
  >
    <slot />

    <slot name='footer' />
  </body>
</html>
