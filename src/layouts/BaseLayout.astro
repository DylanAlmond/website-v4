---
import Header from '../components/Header.astro';
import PageBar from '../components/PageBar.astro';
import '../styles/global.css';
import clsx from 'clsx';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  leftBarLabel?: string;
  rightBarLabel?: string;
  inverted?: boolean;
  class?: string | null;
}

const { title, leftBarLabel, rightBarLabel, inverted = false, class: className } = Astro.props;
---

<html lang='en' x-data=`inverted(${inverted})` :class="$store.menuOpen && 'overflow-hidden'">
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/png' href='/favicon.png' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
    <script src='../scripts/local.ts'></script>
    <ClientRouter />
  </head>
  <body
    class='grain flex h-full min-h-dvh w-full flex-row justify-center gap-12 py-8 transition-[padding] duration-1250 ease-in-out md:py-12'
  >
    <Header />

    <PageBar class='fixed top-0 left-12 py-12' label={leftBarLabel ?? title} />

    <main
      class={clsx(
        'max-w-container mx-8 md:mx-32 transition-all duration-1000 ease-in-out flex-1 relative mt-28',
        className
      )}
    >
      <slot />
    </main>

    <PageBar class='fixed top-0 right-12 py-12' label={rightBarLabel} />
  </body>
</html>
