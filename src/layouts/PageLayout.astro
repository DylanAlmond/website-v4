---
import Header from '../components/Header.astro';
import PageBar from '../components/PageBar.astro';
import clsx from 'clsx';
import type { ShapeOptions } from '../components/ShapeManager';
import Nav from '../components/Nav.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  leftBarLabel?: string;
  rightBarLabel?: string;
  inverted?: boolean;
  class?: string | null;
  shapes?: ShapeOptions[];
}

const {
  title,
  description,
  leftBarLabel,
  rightBarLabel,
  inverted = false,
  shapes,
  class: className
} = Astro.props;
---

<BaseLayout title={title} description={description} inverted={inverted}>
  <!-- Pass down head slot -->
  <Fragment slot='head'>
    <!-- Open Graph -->
    <meta property='og:type' content='website' />
    <slot name='head' />
  </Fragment>

  {
    shapes && (
      <shape-canvas
        :disabled="$store.menuOpen"
        class='absolute top-0 left-0 h-full w-full overflow-hidden opacity-50 transition-opacity duration-700 ease-in-out md:opacity-100'
        shapes={JSON.stringify(shapes)}
      />
    )
  }

  <Header />

  <PageBar class='fixed top-0 left-12 py-12' label={leftBarLabel ?? title} />

  <main
    class={clsx(
      'max-w-container mx-8 md:mx-32 transition-all duration-1000 ease-in-out flex-1 relative mt-18 md:mt-28',
      className
    )}
    :inert='$store.menuOpen'
  >
    <slot />
  </main>

  <PageBar class='fixed top-0 right-12 py-12' label={rightBarLabel} />

  <Nav />

  <Fragment slot='footer'>
    <slot name='footer' />
  </Fragment>
</BaseLayout>
