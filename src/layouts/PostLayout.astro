---
import Header from '../components/Header.astro';
import PageBar from '../components/PageBar.astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import Nav from '../components/Nav.astro';
import BaseLayout from './BaseLayout.astro';
import JsonLD from '../components/JsonLD.astro';
import { site } from '../config/site';
import { BlogPostSchema } from '../config/schema';
import getModifiedTime from '../util/getModifiedTime';

interface Props {
  post: CollectionEntry<'blog'>;
  next: CollectionEntry<'blog'>;
}

const { post, next } = Astro.props;

const formatDate = (d: Date) => d.toLocaleDateString('en-GB', { month: '2-digit', year: 'numeric' });

// Page Meta
const title = `${post.data.title} | Dylan Almond`;
const canonicalUrl = new URL(Astro.url.pathname, site.url);

const { lastModified, dateCreated } = getModifiedTime(post.filePath!);

const pageSchema = await BlogPostSchema(canonicalUrl.toString(), post, dateCreated, lastModified);
---

<BaseLayout
  title={title}
  description={post.data.description ?? title}
>
  <!-- Meta -->
  <Fragment slot='head'>
    <meta name='keywords' content={post.data.tags.join(', ')} />

    <!-- Open Graph -->
    <meta property='og:type' content='article' />
    <meta property='article:published_time' content={dateCreated} />
    <meta property='article:modified_time' content={lastModified} />
    <meta property='article:tag' content={post.data.tags.join(', ')} />
    {
      post.data.image && (
        <>
          <meta property='og:image' content={site.url + post.data.image.src.src} />
          <meta property='og:image:alt' content={post.data.image.alt} />
        </>
      )
    }
    
    <JsonLD graph={pageSchema} />
  </Fragment>

  <Header />

  <PageBar class='fixed top-0 left-12 py-12' label={post.data.title} />

  <main
    class={'max-w-container-sm overflow-hidden mx-8 md:mx-32 transition-all duration-1000 ease-in-out flex-1 relative mt-18 md:mt-28 4xl:mt-0!'}
    :inert='$store.menuOpen'
  >
    <article class='flex flex-col'>
      <header class='flex flex-col gap-4'>
        <!-- Featured Image -->
        <Image
          class={'shadow-xl aspect-16/9 bg-white object-contain w-full mb-4'}
          src={post.data.image.src}
          alt={post.data.image.alt}
          layout={'full-width'}
          loading={'eager'}
        />

        {post.data.draft && <span class='text-red text-2xl md:text-4xl text font-serif'>Draft</span>}

        <h1 class='text-5xl md:text-[5.25em] md:leading-27'>
          {post.data.title}
        </h1>

        <hr class='border-primary w-full border-1' />

        <!-- Post Meta -->
        <section aria-labelledby="post-meta-heading" class='mt-4 flex flex-col gap-8 lg:flex-row'>
          <h2 id="post-meta-heading" class="sr-only">Post details</h2>

          <div class='flex flex-1 flex-col gap-5'>
            <!-- Tags -->
            <div class='grid grid-cols-[10em_1fr]'>
              <span class='font-sans! text-xl font-bold md:text-2xl'>Category</span>

              <ul class='text-primary/80 text-lg capitalize md:mt-1 md:text-xl'>
                {post.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>

            <!-- Published -->
            <div class='grid grid-cols-[10em_1fr]'>
              <span class='font-sans! text-xl font-bold md:text-2xl'>Period</span>

              <span class="text-primary/80 text-lg capitalize md:mt-1 md:text-xl">
                <time 
                  datetime={post.data.dateStarted.toISOString()}
                >
                  {formatDate(post.data.dateStarted)}
                </time>

                <span>-</span>

                {post.data.dateFinished ? (
                  <time 
                    datetime={post.data.dateFinished.toISOString()}
                  >
                    {formatDate(post.data.dateFinished)}
                  </time>
                ) : <span>Ongoing</span>}
              </span>

       
            </div>
          </div>

          {(post.data.description || post.data.link) && (
            <div class='flex flex-1 flex-col gap-4 items-start'>
                <!-- Description -->
                {
                  post.data.description && (
                    <p class='text-primary/80 text-lg'>{post.data.description}</p>
                  )
                }

                <!-- Link -->
                {
                  post.data.link && (
                    <a 
                      aria-label="Visit Project Link"           
                      target="_blank"
                      rel="noopener noreferrer" 
                      href={post.data.link} 
                      class='text-[#20577E] transition-all duration-250 ease-in-out hover:opacity-60 mt-0.5 text-lg md:mt-1 md:text-xl'
                    >
                      {post.data.link}
                    </a>
                  )
                }
            </div>
          )}
        </section>
      </header>

      <!-- Post Content -->
      <section class='prose'>
        <slot />
      </section>

      <footer
        class='border-primary flex-wrap mt-8 flex justify-between gap-4 border-t-2 pt-3 flex-row items-center md:pt-8'
      >
        {post.data.draft && <span class='text-red w-full text-2xl md:text-4xl text font-serif'>Draft</span>}
        <span class='font-serif text-[2em] md:text-5xl'>{post.data.title}</span>

        <Button href={`/work/${next.id}`}>Next Project</Button>
      </footer>
    </article>
  </main>

  <PageBar class='fixed top-0 right-12 py-12' />

  <Nav />
</BaseLayout>

<style>
  @reference '../styles/global.css';

  :root {
    scroll-behavior: smooth;
    scroll-padding: 7em;
  }

  .prose {
    @apply text-primary/80 flex flex-col text-lg leading-relaxed;

    ul,
    ol,
    p {
      @apply mb-2;
    }
    
    ul {
      @apply list-disc pl-8;
    }

    ol {
      @apply list-decimal pl-8;
    }

    a {
      @apply underline transition-all duration-250 hover:opacity-60;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      @apply text-primary font-serif mt-4 mb-2 font-bold tracking-wider leading-snug;
    }

    h1 {
      @apply text-[3.5em] border-b-2 border-primary pb-2 mt-8 mb-4;
    }

    h2 {
      @apply text-[2.75em] border-b-2 border-primary pb-2 mt-8 mb-4;
    }

    h3 {
      @apply text-[2.25em];
    }

    h4 {
      @apply text-[1.5em];
    }

    h5 {
      @apply text-[1.25em];
    }

    h6 {
      @apply text-[1em];
    }

    img,
    video {
      @apply mt-6 w-full shadow-xl md:mt-8 max-h-[800px] bg-white object-contain;
    }

    table {
      @apply border-1 border-primary/40 block overflow-x-auto;
    }

    thead {
      @apply bg-primary/10;
    }

    th {
      @apply py-3 px-4 text-start text-primary border-r border-primary/40;
    }

    tbody {
    }

    tr {
      @apply border-b border-primary/40 nth-[2n]:bg-primary/5;
    }

    td {
      @apply py-3 px-4 first:text-primary border-r border-primary/40;
    }

    hr {
      @apply border-1 border-primary;
    }
  }
</style>
