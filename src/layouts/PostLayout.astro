---
import Header from '../components/Header.astro';
import PageBar from '../components/PageBar.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import Nav from '../components/Nav.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  next: CollectionEntry<'blog'>;
}

const { post, next } = Astro.props;
---

<html lang='en' x-data='inverted(false)' :class="$store.menuOpen && 'overflow-hidden'">
  <head>
    <meta charset='utf-8' />
    <link rel='icon' type='image/png' href='/favicon.png' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='generator' content={Astro.generator} />
    <title>{post.data.title} - Dylan Almond</title>
    <script src='../scripts/local.ts'></script>
    <ClientRouter />
  </head>
  <body
    class='grain flex h-full min-h-dvh w-full flex-row justify-center gap-12 py-8 transition-[padding] duration-1250 ease-in-out md:py-12'
  >
    <Header />

    <PageBar class='fixed top-0 left-12 py-12' label={`Work - ${post.data.title}`} />

    <main
      class={'max-w-container-sm mx-8 md:mx-32 transition-all duration-1000 ease-in-out flex-1 relative mt-28 4xl:mt-0'}
      :inert='$store.menuOpen'
    >
      <article class='flex flex-col'>
        <!-- Featured Image -->
        <Image
          class={'shadow-xl aspect-16/9 bg-white object-contain w-full'}
          src={post.data.image.src}
          alt={post.data.image.alt}
          layout={'full-width'}
        />

        <header class='mt-8 flex flex-col gap-4'>
          <h1 class='text-5xl md:text-[5.25rem] md:leading-27'>{post.data.title}</h1>

          <hr class='border-primary w-full border-1' />

          <div class='mt-4 flex flex-col gap-8 lg:flex-row'>
            <div class='flex flex-1 flex-col gap-5'>
              <!-- Tags -->
              <div class='grid grid-cols-[10rem_1fr]'>
                <h6 class='font-sans! text-xl font-bold md:text-2xl'>Category</h6>

                <ul class='text-primary/80 mt-0.5 text-lg capitalize md:mt-1 md:text-xl'>
                  {post.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>

              <!-- Published -->
              <div class='grid grid-cols-[10rem_1fr]'>
                <h6 class='font-sans! text-xl font-bold md:text-2xl'>Year</h6>

                <span class='text-primary/80 mt-0.5 text-lg capitalize md:mt-1 md:text-xl'
                  >{post.data.date.getFullYear()}</span
                >
              </div>
            </div>

            <!-- Description -->
            {
              post.data.description && (
                <p class='text-primary/80 flex-1 text-xl'>{post.data.description}</p>
              )
            }
          </div>
        </header>

        <!-- Post Content -->
        <section class='prose'>
          <slot />
        </section>

        <footer
          class='border-primary mt-8 flex flex-col items-start justify-between gap-4 border-t-2 pt-3 md:flex-row md:items-center md:pt-8'
        >
          <span class='font-serif text-[2rem] md:text-5xl'>{post.data.title}</span>

          <Button href={`/work/${next.id}`}>Next Project</Button>
        </footer>
      </article>
    </main>

    <PageBar class='fixed top-0 right-12 py-12' />

    <Nav />
  </body>
</html>

<style>
  @reference '../styles/global.css';

  .prose {
    @apply text-primary/80 flex flex-col gap-4 text-xl;

    ul {
      @apply list-inside list-disc;
    }

    ol {
      @apply list-inside list-decimal;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      @apply text-primary mt-6 font-serif md:mt-8;
    }

    h1 {
      @apply text-[3.5rem] md:text-[4rem];
    }

    h2 {
      @apply text-[3rem] md:text-[3.5rem];
    }

    h3 {
      @apply text-[2.5rem] md:text-[3rem];
    }

    h4 {
      @apply text-[2rem] md:text-[2.5rem];
    }

    h5 {
      @apply text-[1.5rem] md:text-[2rem];
    }

    h6 {
      @apply text-[1.25rem] md:text-[1.5rem];
    }

    img,
    video {
      @apply mt-6 w-full shadow-xl md:mt-8;
    }
  }
</style>
