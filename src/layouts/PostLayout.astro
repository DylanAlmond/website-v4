---
import Header from '../components/Header.astro';
import PageBar from '../components/PageBar.astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import Nav from '../components/Nav.astro';
import BaseLayout from './BaseLayout.astro';
import JsonLD from '../components/JsonLD.astro';
import { site } from '../config/site';
import { BlogPostSchema } from '../config/schema';
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";

dayjs.extend(utc);

interface Props {
  post: CollectionEntry<'blog'>;
  next: CollectionEntry<'blog'>;
  remarkPluginFrontmatter: Record<string, any>;
}

const { post, next, remarkPluginFrontmatter } = Astro.props;

// Page Meta
const title = `${post.data.title} | Dylan Almond`;
const canonicalUrl = new URL(Astro.url.pathname, site.url);
const lastModifiedISO = dayjs(remarkPluginFrontmatter.lastModified).toISOString();
const pageSchema = BlogPostSchema(canonicalUrl.toString(), post, lastModifiedISO);
---

<BaseLayout
  title={title}
  description={post.data.description ?? title}
>
  <!-- Meta -->
  <Fragment slot='head'>
    <meta name='keywords' content={post.data.tags.join(', ')} />

    <!-- Open Graph -->
    <meta property='og:type' content='article' />
    <meta property='article:published_time' content={post.data.date.toISOString()} />
    <meta property='article:modified_time' content={lastModifiedISO} />
    <meta property='article:tag' content={post.data.tags.join(', ')} />
    {
      post.data.image && (
        <>
          <meta property='og:image' content={site.url + post.data.image.src.src} />
          <meta property='og:image:alt' content={post.data.image.alt} />
        </>
      )
    }
    
    <JsonLD graph={pageSchema} />
  </Fragment>

  <Header />

  <PageBar class='fixed top-0 left-12 py-12' label={post.data.title} />

  <main
    class={'max-w-container-sm mx-8 md:mx-32 transition-all duration-1000 ease-in-out flex-1 relative mt-18 md:mt-28 4xl:mt-0!'}
    :inert='$store.menuOpen'
  >
    <article class='flex flex-col'>
      <header class='flex flex-col gap-4'>
        <!-- Featured Image -->
        <Image
          class={'shadow-xl aspect-16/9 bg-white object-contain w-full mb-4'}
          src={post.data.image.src}
          alt={post.data.image.alt}
          layout={'full-width'}
          loading={'eager'}
        />

        <h1 class='text-5xl md:text-[5.25rem] md:leading-27'>{post.data.title}</h1>

        <hr class='border-primary w-full border-1' />

        <!-- Post Meta -->
        <section aria-labelledby="post-meta-heading" class='mt-4 flex flex-col gap-8 lg:flex-row'>
          <h2 id="post-meta-heading" class="sr-only">Post details</h2>

          <div class='flex flex-1 flex-col gap-5'>
            <!-- Tags -->
            <div class='grid grid-cols-[10rem_1fr]'>
              <span class='font-sans! text-xl font-bold md:text-2xl'>Category</span>

              <ul class='text-primary/80 mt-0.5 text-lg capitalize md:mt-1 md:text-xl'>
                {post.data.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>

            <!-- Published -->
            <div class='grid grid-cols-[10rem_1fr]'>
              <span class='font-sans! text-xl font-bold md:text-2xl'>Year</span>

              <time class='text-primary/80 mt-0.5 text-lg capitalize md:mt-1 md:text-xl' datetime={post.data.date.toISOString()}>{post.data.date.getFullYear()}</time>
            </div>
          </div>

          {(post.data.description || post.data.link) && (
            <div class='flex flex-1 flex-col gap-4 items-start'>
                <!-- Description -->
                {
                  post.data.description && (
                    <p class='text-primary/80 text-xl'>{post.data.description}</p>
                  )
                }

                <!-- Link -->
                {
                  post.data.link && (
                    <a 
                      aria-label="Visit Project Link"           
                      target="_blank"
                      rel="noopener noreferrer" 
                      href={post.data.link} 
                      class='text-[#20577E] transition-all duration-250 ease-in-out hover:opacity-60 mt-0.5 text-lg md:mt-1 md:text-xl'
                    >
                      {post.data.link}
                    </a>
                  )
                }
            </div>
          )}
        </section>
      </header>

      <!-- Post Content -->
      <section class='prose'>
        <slot />
      </section>

      <footer
        class='border-primary flex-wrap mt-8 flex justify-between gap-4 border-t-2 pt-3 flex-row items-center md:pt-8'
      >
        <span class='font-serif text-[2rem] md:text-5xl'>{post.data.title}</span>

        <Button href={`/work/${next.id}`}>Next Project</Button>
      </footer>
    </article>
  </main>

  <PageBar class='fixed top-0 right-12 py-12' />

  <Nav />
</BaseLayout>

<style>
  @reference '../styles/global.css';

  .prose {
    @apply text-primary/80 flex flex-col gap-4 text-xl;

    ul {
      @apply list-inside list-disc;
    }

    ol {
      @apply list-inside list-decimal;
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      @apply text-primary mt-6 font-serif md:mt-8;
    }

    h1 {
      @apply text-[3.5rem] md:text-[4rem];
    }

    h2 {
      @apply text-[3rem] md:text-[3.5rem];
    }

    h3 {
      @apply text-[2.5rem] md:text-[3rem];
    }

    h4 {
      @apply text-[2rem] md:text-[2.5rem];
    }

    h5 {
      @apply text-[1.5rem] md:text-[2rem];
    }

    h6 {
      @apply text-[1.25rem] md:text-[1.5rem];
    }

    img,
    video {
      @apply mt-6 w-full shadow-xl md:mt-8;
    }
  }
</style>
